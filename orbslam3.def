Bootstrap: docker
From: ubuntu:22.04

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -y
    apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build git wget \
        libeigen3-dev \
        libopencv-dev libopencv-contrib-dev \
        libboost-all-dev \
        libssl-dev libcurl4-openssl-dev \
        python3 python3-pip \
        \
        # Pangolin dependencies (headless OpenGL via Mesa)
        libgl1-mesa-dev libglu1-mesa-dev \
        libglew-dev libglfw3-dev \
        libosmesa6-dev mesa-utils \
        libxrandr-dev libxxf86vm-dev libxi-dev libxinerama-dev libxcursor-dev \
        wayland-protocols libwayland-dev \
        libepoxy-dev \
    && rm -rf /var/lib/apt/lists/*

    # ── Pangolin (headless-compatible) ───────────────────────────────────────
    git clone --depth 1 https://github.com/stevenlovegrove/Pangolin.git /opt/pangolin_src
    cmake -S /opt/pangolin_src -B /opt/pangolin_build \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TOOLS=OFF \
        -DBUILD_EXAMPLES=OFF \
        -DBUILD_TESTS=OFF
    cmake --build /opt/pangolin_build --parallel $(nproc)
    cmake --install /opt/pangolin_build
    rm -rf /opt/pangolin_src /opt/pangolin_build

%environment
    export PATH=/usr/local/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH
